        <process id="cn.ibizlab.plm.core.ai.service.logic.ai_knowledge_basefill_temp" isClosed="false" isExecutable="true" name="ai_ai_knowledge_base_fill_temp_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.ai.service.logic.ai_knowledge_basefill_temp">
