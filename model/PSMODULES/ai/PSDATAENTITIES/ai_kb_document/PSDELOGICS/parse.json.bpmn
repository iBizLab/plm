<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.ai.service.logic.ai_kb_documentparse" isClosed="false" isExecutable="true" name="ai_ai_kb_document_parse_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.ai.service.logic.ai_kb_documentparse">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_kb_documentparsedefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_agent_context()" name="ai_kb_documentparseagent_context" type="refentity"/>
                                <tns:metaData express="new HashMap()" name="ai_kb_documentparselastreturn" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_kb_document()" name="ai_kb_documentparsemasked_data" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_kb_documentService))" name="ai_kb_documentservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_kb_documentService))" name="iBzSysAi_kb_documentDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_kb_documentparsedefault" type="cn.ibizlab.plm.core.ai.domain.ai_kb_document" />
                            <tns:global identifier="ai_kb_documentparseagent_context" type="cn.ibizlab.plm.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_kb_documentparsemasked_data" type="cn.ibizlab.plm.core.ai.domain.ai_kb_document" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparsedeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="获取数据"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparserawsfcode_01" id="rawsfcode_01" implementation="http://www.jboss.org/drools/rule" name="获取origin文件内容"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparsedebugparam_01" id="debugparam_01" implementation="http://www.jboss.org/drools/rule" name="调试逻辑参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparsedeaction_03" id="deaction_03" implementation="http://www.jboss.org/drools/rule" name="提取元数据"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparserawsfcode_03" id="rawsfcode_03" implementation="http://www.jboss.org/drools/rule" name="实体打印"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparserawsfcode_02" id="rawsfcode_02" implementation="http://www.jboss.org/drools/rule" name="正则解析文档内容"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparseprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparsedebugparam_02" id="debugparam_02" implementation="http://www.jboss.org/drools/rule" name="调试逻辑参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparserawsfcode_04" id="rawsfcode_04" implementation="http://www.jboss.org/drools/rule" name="使用工具类解析"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparsedeaction_02" id="deaction_02" implementation="http://www.jboss.org/drools/rule" name="实体行为"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentparseend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_deaction_01" sourceRef="begin" targetRef="deaction_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_01_rawsfcode_03" sourceRef="gateway-deaction_01" targetRef="rawsfcode_03">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_kb_documentparsedefault:ai_kb_document();
                                            $ai_kb_documentparseagent_context:ai_agent_context();
                                            $ai_kb_documentparselastreturn:Map();
                                            $ai_kb_documentparsemasked_data:ai_kb_document();
                                    eval($ai_kb_documentparsedefault==ai_kb_documentparsedefault && $ai_kb_documentparseagent_context==ai_kb_documentparseagent_context && $ai_kb_documentparsemasked_data==ai_kb_documentparsemasked_data);
                                eval((RuleUtils.test($ai_kb_documentparsedefault.get("type"),"NOTEQ","file"))&&(RuleUtils.test($ai_kb_documentparsedefault.get("sourceType"),"ISNOTNULL",""))&&(RuleUtils.test($ai_kb_documentparsedefault.get("sourceId"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_01_rawsfcode_01" sourceRef="gateway-deaction_01" targetRef="rawsfcode_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_kb_documentparsedefault:ai_kb_document();
                                            $ai_kb_documentparseagent_context:ai_agent_context();
                                            $ai_kb_documentparselastreturn:Map();
                                            $ai_kb_documentparsemasked_data:ai_kb_document();
                                    eval($ai_kb_documentparsedefault==ai_kb_documentparsedefault && $ai_kb_documentparseagent_context==ai_kb_documentparseagent_context && $ai_kb_documentparsemasked_data==ai_kb_documentparsemasked_data);
                                eval((RuleUtils.test($ai_kb_documentparsedefault.get("type"),"EQ","file"))&&(RuleUtils.test($ai_kb_documentparsedefault.get("file"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_01_debugparam_01" sourceRef="rawsfcode_01" targetRef="debugparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="debugparam_01_deaction_03" sourceRef="debugparam_01" targetRef="deaction_03">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_03_prepareparam_01" sourceRef="deaction_03" targetRef="prepareparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_03_debugparam_01" sourceRef="rawsfcode_03" targetRef="debugparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_02_debugparam_02" sourceRef="rawsfcode_02" targetRef="debugparam_02">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_rawsfcode_04" sourceRef="prepareparam_01" targetRef="rawsfcode_04">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-debugparam_02_deaction_02" sourceRef="gateway-debugparam_02" targetRef="deaction_02">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_kb_documentparsedefault:ai_kb_document();
                                            $ai_kb_documentparseagent_context:ai_agent_context();
                                            $ai_kb_documentparselastreturn:Map();
                                            $ai_kb_documentparsemasked_data:ai_kb_document();
                                    eval($ai_kb_documentparsedefault==ai_kb_documentparsedefault && $ai_kb_documentparseagent_context==ai_kb_documentparseagent_context && $ai_kb_documentparsemasked_data==ai_kb_documentparsemasked_data);
                                eval((RuleUtils.test($ai_kb_documentparsemasked_data.get("id"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_04_debugparam_02" sourceRef="rawsfcode_04" targetRef="debugparam_02">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_02_end_01" sourceRef="deaction_02" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-deaction_01" name="Gateway" gatewayDirection="Diverging" default="gateway-deaction_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="deaction_01_gateway-deaction_01_gatewayline" sourceRef="deaction_01" targetRef="gateway-deaction_01"></sequenceFlow>
                            <sequenceFlow id="gateway-deaction_01_end_line" sourceRef="gateway-deaction_01" targetRef="gateway-deaction_01_end"/>
                            <endEvent id="gateway-deaction_01_end" name="end"/>
                            <exclusiveGateway id="gateway-debugparam_02" name="Gateway" gatewayDirection="Diverging" default="gateway-debugparam_02_end_line"></exclusiveGateway>
                            <sequenceFlow id="debugparam_02_gateway-debugparam_02_gatewayline" sourceRef="debugparam_02" targetRef="gateway-debugparam_02"></sequenceFlow>
                            <sequenceFlow id="gateway-debugparam_02_end_line" sourceRef="gateway-debugparam_02" targetRef="gateway-debugparam_02_end"/>
                            <endEvent id="gateway-debugparam_02_end" name="end"/>
        </process>
    </definitions>