<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.ai.service.logic.ai_kb_documentreparse" isClosed="false" isExecutable="true" name="ai_ai_kb_document_reparse_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.ai.service.logic.ai_kb_documentreparse">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_kb_documentreparsedefault" type="entity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_kb_documentService))" name="ai_kb_documentservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_kb_documentService))" name="iBzSysAi_kb_documentDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_kb_documentreparsedefault" type="cn.ibizlab.plm.core.ai.domain.ai_kb_document" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentreparseend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentreparsedeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="异步解析文档数据"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentreparsedeaction_02" id="deaction_02" implementation="http://www.jboss.org/drools/rule" name="获取数据"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentreparseprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="置空parsed_content"/>
                    <sequenceFlow id="begin_deaction_02" sourceRef="begin" targetRef="deaction_02">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_01_end_01" sourceRef="deaction_01" targetRef="end_01">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_02_prepareparam_01" sourceRef="deaction_02" targetRef="prepareparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_deaction_01" sourceRef="prepareparam_01" targetRef="deaction_01">
                    </sequenceFlow>
        </process>
    </definitions>