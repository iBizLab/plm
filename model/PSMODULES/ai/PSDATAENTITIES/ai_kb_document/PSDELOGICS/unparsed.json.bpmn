<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.ai.service.logic.ai_kb_documentunparsed" isClosed="false" isExecutable="true" name="ai_ai_kb_document_unparsed_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.ai.service.logic.ai_kb_documentunparsed">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_kb_documentunparseddefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_kb_document()" name="ai_kb_documentunparseddoc" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_kb_document()" name="ai_kb_documentunparsedpage" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_kb_documentService))" name="ai_kb_documentservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_kb_documentService))" name="iBzSysAi_kb_documentDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_kb_documentunparseddefault" type="cn.ibizlab.plm.core.ai.domain.ai_kb_document" />
                            <tns:global identifier="ai_kb_documentunparseddoc" type="cn.ibizlab.plm.core.ai.domain.ai_kb_document" />
                            <tns:global identifier="ai_kb_documentunparsedpage" type="cn.ibizlab.plm.core.ai.domain.ai_kb_document" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentunparseddedataquery_01" id="dedataquery_01" implementation="http://www.jboss.org/drools/rule" name="查询未切片"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentunparsedloopsubcall_01" id="loopsubcall_01" implementation="http://www.jboss.org/drools/rule" name="循环子调用"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentunparsedend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_kb_documentunparsedprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="置空查询parsing_config"/>
                        <endEvent id="prepareparam_01_end" name="end"/>
                        <sequenceFlow id="prepareparam_01_end_line" sourceRef="prepareparam_01" targetRef="prepareparam_01_end"/>
                    <sequenceFlow id="begin_dedataquery_01" sourceRef="begin" targetRef="dedataquery_01">
                    </sequenceFlow>
                    <sequenceFlow id="dedataquery_01_loopsubcall_01" sourceRef="dedataquery_01" targetRef="loopsubcall_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-loopsubcall_01_prepareparam_01" sourceRef="gateway-loopsubcall_01" targetRef="prepareparam_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_kb_documentunparseddefault:ai_kb_document();
                                            $ai_kb_documentunparseddoc:ai_kb_document();
                                            $ai_kb_documentunparsedpage:ai_kb_document();
                                    eval($ai_kb_documentunparseddefault==ai_kb_documentunparseddefault && $ai_kb_documentunparseddoc==ai_kb_documentunparseddoc && $ai_kb_documentunparsedpage==ai_kb_documentunparsedpage);
                                eval((RuleUtils.test($ai_kb_documentunparseddoc.get("customChunk"),"EQ","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="loopsubcall_01_end_01" sourceRef="loopsubcall_01" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-loopsubcall_01" name="Gateway" gatewayDirection="Diverging" default="gateway-loopsubcall_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="loopsubcall_01_gateway-loopsubcall_01_gatewayline" sourceRef="loopsubcall_01" targetRef="gateway-loopsubcall_01"></sequenceFlow>
                            <sequenceFlow id="gateway-loopsubcall_01_end_line" sourceRef="gateway-loopsubcall_01" targetRef="gateway-loopsubcall_01_end"/>
                            <endEvent id="gateway-loopsubcall_01_end" name="end"/>
        </process>
    </definitions>