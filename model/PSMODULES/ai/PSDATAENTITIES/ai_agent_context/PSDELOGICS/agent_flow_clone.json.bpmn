<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.ai.service.logic.ai_agent_contextagent_flow_clone" isClosed="false" isExecutable="true" name="ai_ai_agent_context_agent_flow_clone_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.ai.service.logic.ai_agent_contextagent_flow_clone">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_agent_contextagent_flow_clonedefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_agent_context()" name="ai_agent_contextagent_flow_cloneclone_ag_context" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_agent_context()" name="ai_agent_contextagent_flow_cloneclone_ag_context2" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.extension.domain.PSDELogic()" name="ai_agent_contextagent_flow_cloneclone_delogic" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_agent_context()" name="ai_agent_contextagent_flow_cloneoriginal_ag_context" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.extension.domain.PSDELogic()" name="ai_agent_contextagent_flow_cloneoriginal_delogic" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_agent_contextService))" name="ai_agent_contextservice" type="service"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.extension.service.IPSDELogicService))" name="psdelogicservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_agent_contextService))" name="iBzSysAi_agent_contextDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_agent_contextagent_flow_clonedefault" type="cn.ibizlab.plm.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextagent_flow_cloneclone_ag_context" type="cn.ibizlab.plm.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextagent_flow_cloneclone_ag_context2" type="cn.ibizlab.plm.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextagent_flow_cloneclone_delogic" type="cn.ibizlab.plm.core.extension.domain.PSDELogic" />
                            <tns:global identifier="ai_agent_contextagent_flow_cloneoriginal_ag_context" type="cn.ibizlab.plm.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextagent_flow_cloneoriginal_delogic" type="cn.ibizlab.plm.core.extension.domain.PSDELogic" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_cloneprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="设置新context数据"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_clonecopyparam_01" id="copyparam_01" implementation="http://www.jboss.org/drools/rule" name="拷贝参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_cloneprepareparam_02" id="prepareparam_02" implementation="http://www.jboss.org/drools/rule" name="备份页面填写信息"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_clonedeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="获取选中flow智能体数据"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_clonedeaction_02" id="deaction_02" implementation="http://www.jboss.org/drools/rule" name="创建flow智能体"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_clonerawsfcode_03" id="rawsfcode_03" implementation="http://www.jboss.org/drools/rule" name="查看新逻辑信息"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_clonecopyparam_02" id="copyparam_02" implementation="http://www.jboss.org/drools/rule" name="拷贝参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_clonedeaction_03" id="deaction_03" implementation="http://www.jboss.org/drools/rule" name="获取选择flow智能体逻辑"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_clonerawsfcode_01" id="rawsfcode_01" implementation="http://www.jboss.org/drools/rule" name="拼接选择逻辑id"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_clonedeaction_04" id="deaction_04" implementation="http://www.jboss.org/drools/rule" name="创建logic"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_clonedeaction_05" id="deaction_05" implementation="http://www.jboss.org/drools/rule" name="应用逻辑"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextagent_flow_cloneend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_prepareparam_02" sourceRef="begin" targetRef="prepareparam_02">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_deaction_02" sourceRef="prepareparam_01" targetRef="deaction_02">
                    </sequenceFlow>
                    <sequenceFlow id="copyparam_01_prepareparam_01" sourceRef="copyparam_01" targetRef="prepareparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_02_deaction_01" sourceRef="prepareparam_02" targetRef="deaction_01">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_01_copyparam_01" sourceRef="deaction_01" targetRef="copyparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_02_rawsfcode_01" sourceRef="deaction_02" targetRef="rawsfcode_01">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_03_deaction_04" sourceRef="rawsfcode_03" targetRef="deaction_04">
                    </sequenceFlow>
                    <sequenceFlow id="copyparam_02_rawsfcode_03" sourceRef="copyparam_02" targetRef="rawsfcode_03">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_03_copyparam_02" sourceRef="gateway-deaction_03" targetRef="copyparam_02">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextagent_flow_clonedefault:ai_agent_context();
                                            $ai_agent_contextagent_flow_cloneclone_ag_context:ai_agent_context();
                                            $ai_agent_contextagent_flow_cloneclone_ag_context2:ai_agent_context();
                                            $ai_agent_contextagent_flow_cloneclone_delogic:PSDELogic();
                                            $ai_agent_contextagent_flow_cloneoriginal_ag_context:ai_agent_context();
                                            $ai_agent_contextagent_flow_cloneoriginal_delogic:PSDELogic();
                                    eval($ai_agent_contextagent_flow_clonedefault==ai_agent_contextagent_flow_clonedefault && $ai_agent_contextagent_flow_cloneclone_ag_context==ai_agent_contextagent_flow_cloneclone_ag_context && $ai_agent_contextagent_flow_cloneclone_ag_context2==ai_agent_contextagent_flow_cloneclone_ag_context2 && $ai_agent_contextagent_flow_cloneclone_delogic==ai_agent_contextagent_flow_cloneclone_delogic && $ai_agent_contextagent_flow_cloneoriginal_ag_context==ai_agent_contextagent_flow_cloneoriginal_ag_context && $ai_agent_contextagent_flow_cloneoriginal_delogic==ai_agent_contextagent_flow_cloneoriginal_delogic);
                                eval((RuleUtils.test($ai_agent_contextagent_flow_cloneoriginal_delogic.get("psdelogicid"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_01_deaction_03" sourceRef="rawsfcode_01" targetRef="deaction_03">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_04_deaction_05" sourceRef="deaction_04" targetRef="deaction_05">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_05_end_01" sourceRef="deaction_05" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-deaction_03" name="Gateway" gatewayDirection="Diverging" default="gateway-deaction_03_end_line"></exclusiveGateway>
                            <sequenceFlow id="deaction_03_gateway-deaction_03_gatewayline" sourceRef="deaction_03" targetRef="gateway-deaction_03"></sequenceFlow>
                            <sequenceFlow id="gateway-deaction_03_end_line" sourceRef="gateway-deaction_03" targetRef="gateway-deaction_03_end"/>
                            <endEvent id="gateway-deaction_03_end" name="end"/>
        </process>
    </definitions>