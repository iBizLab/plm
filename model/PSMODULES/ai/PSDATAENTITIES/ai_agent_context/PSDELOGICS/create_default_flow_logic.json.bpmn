<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.ai.service.logic.ai_agent_contextcreate_default_flow_logic" isClosed="false" isExecutable="true" name="ai_ai_agent_context_create_default_flow_logic_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.ai.service.logic.ai_agent_contextcreate_default_flow_logic">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_agent_contextcreate_default_flow_logicdefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_agent_context()" name="ai_agent_contextcreate_default_flow_logicoriginal_ag_context" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.extension.domain.PSDELogic()" name="ai_agent_contextcreate_default_flow_logicoriginal_delogic" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.extension.service.IPSDELogicService))" name="psdelogicservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_agent_contextService))" name="iBzSysAi_agent_contextDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_agent_contextcreate_default_flow_logicdefault" type="cn.ibizlab.plm.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextcreate_default_flow_logicoriginal_ag_context" type="cn.ibizlab.plm.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextcreate_default_flow_logicoriginal_delogic" type="cn.ibizlab.plm.core.extension.domain.PSDELogic" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextcreate_default_flow_logicprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="准备模板智能体逻辑"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextcreate_default_flow_logicdeaction_03" id="deaction_03" implementation="http://www.jboss.org/drools/rule" name="获取选择flow智能体逻辑"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextcreate_default_flow_logicdeaction_04" id="deaction_04" implementation="http://www.jboss.org/drools/rule" name="创建logic"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextcreate_default_flow_logicrawsfcode_03" id="rawsfcode_03" implementation="http://www.jboss.org/drools/rule" name="构造新逻辑信息"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextcreate_default_flow_logicdeaction_05" id="deaction_05" implementation="http://www.jboss.org/drools/rule" name="应用逻辑"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextcreate_default_flow_logicend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="gateway-begin_prepareparam_01" sourceRef="gateway-begin" targetRef="prepareparam_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextcreate_default_flow_logicdefault:ai_agent_context();
                                            $ai_agent_contextcreate_default_flow_logicoriginal_ag_context:ai_agent_context();
                                            $ai_agent_contextcreate_default_flow_logicoriginal_delogic:PSDELogic();
                                    eval($ai_agent_contextcreate_default_flow_logicdefault==ai_agent_contextcreate_default_flow_logicdefault && $ai_agent_contextcreate_default_flow_logicoriginal_ag_context==ai_agent_contextcreate_default_flow_logicoriginal_ag_context && $ai_agent_contextcreate_default_flow_logicoriginal_delogic==ai_agent_contextcreate_default_flow_logicoriginal_delogic);
                                eval((RuleUtils.test($ai_agent_contextcreate_default_flow_logicdefault.get("flowMode"),"EQ","DE")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_deaction_03" sourceRef="prepareparam_01" targetRef="deaction_03">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_03_rawsfcode_03" sourceRef="gateway-deaction_03" targetRef="rawsfcode_03">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextcreate_default_flow_logicdefault:ai_agent_context();
                                            $ai_agent_contextcreate_default_flow_logicoriginal_ag_context:ai_agent_context();
                                            $ai_agent_contextcreate_default_flow_logicoriginal_delogic:PSDELogic();
                                    eval($ai_agent_contextcreate_default_flow_logicdefault==ai_agent_contextcreate_default_flow_logicdefault && $ai_agent_contextcreate_default_flow_logicoriginal_ag_context==ai_agent_contextcreate_default_flow_logicoriginal_ag_context && $ai_agent_contextcreate_default_flow_logicoriginal_delogic==ai_agent_contextcreate_default_flow_logicoriginal_delogic);
                                eval((RuleUtils.test($ai_agent_contextcreate_default_flow_logicoriginal_delogic.get("psdelogicid"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="deaction_04_deaction_05" sourceRef="deaction_04" targetRef="deaction_05">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_03_deaction_04" sourceRef="rawsfcode_03" targetRef="deaction_04">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_05_end_01" sourceRef="deaction_05" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-begin" name="Gateway" gatewayDirection="Diverging" default="gateway-begin_end_line"></exclusiveGateway>
                            <sequenceFlow id="begin_gateway-begin_gatewayline" sourceRef="begin" targetRef="gateway-begin"></sequenceFlow>
                            <sequenceFlow id="gateway-begin_end_line" sourceRef="gateway-begin" targetRef="gateway-begin_end"/>
                            <endEvent id="gateway-begin_end" name="end"/>
                            <exclusiveGateway id="gateway-deaction_03" name="Gateway" gatewayDirection="Diverging" default="gateway-deaction_03_end_line"></exclusiveGateway>
                            <sequenceFlow id="deaction_03_gateway-deaction_03_gatewayline" sourceRef="deaction_03" targetRef="gateway-deaction_03"></sequenceFlow>
                            <sequenceFlow id="gateway-deaction_03_end_line" sourceRef="gateway-deaction_03" targetRef="gateway-deaction_03_end"/>
                            <endEvent id="gateway-deaction_03_end" name="end"/>
        </process>
    </definitions>