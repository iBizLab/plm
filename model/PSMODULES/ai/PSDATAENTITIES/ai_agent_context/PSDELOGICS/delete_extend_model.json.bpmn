<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.ai.service.logic.ai_agent_contextdelete_extend_model" isClosed="false" isExecutable="true" name="ai_ai_agent_context_delete_extend_model_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.ai.service.logic.ai_agent_contextdelete_extend_model">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_agent_contextdelete_extend_modeldefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.extension.domain.PSDELogic()" name="ai_agent_contextdelete_extend_modeldelogic" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.extension.service.IPSDELogicService))" name="psdelogicservice" type="service"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_agent_contextService))" name="ai_agent_contextservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_agent_contextService))" name="iBzSysAi_agent_contextDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_agent_contextdelete_extend_modeldefault" type="cn.ibizlab.plm.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextdelete_extend_modeldelogic" type="cn.ibizlab.plm.core.extension.domain.PSDELogic" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdelete_extend_modeldeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="获取extend_logic"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdelete_extend_modeldeaction_02" id="deaction_02" implementation="http://www.jboss.org/drools/rule" name="删除extend_logic"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdelete_extend_modeldeaction_03" id="deaction_03" implementation="http://www.jboss.org/drools/rule" name="获取agent_context"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdelete_extend_modeldebugparam_01" id="debugparam_01" implementation="http://www.jboss.org/drools/rule" name="查看logic数据"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdelete_extend_modelend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdelete_extend_modelrawsfcode_01" id="rawsfcode_01" implementation="http://www.jboss.org/drools/rule" name="拼接model标识"/>
                    <sequenceFlow id="begin_deaction_03" sourceRef="begin" targetRef="deaction_03">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_01_debugparam_01" sourceRef="gateway-deaction_01" targetRef="debugparam_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextdelete_extend_modeldefault:ai_agent_context();
                                            $ai_agent_contextdelete_extend_modeldelogic:PSDELogic();
                                    eval($ai_agent_contextdelete_extend_modeldefault==ai_agent_contextdelete_extend_modeldefault && $ai_agent_contextdelete_extend_modeldelogic==ai_agent_contextdelete_extend_modeldelogic);
                                eval((RuleUtils.test($ai_agent_contextdelete_extend_modeldelogic.get("dynamodelflag"),"EQ","1")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="deaction_02_end_01" sourceRef="deaction_02" targetRef="end_01">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_03_rawsfcode_01" sourceRef="deaction_03" targetRef="rawsfcode_01">
                    </sequenceFlow>
                    <sequenceFlow id="debugparam_01_deaction_02" sourceRef="debugparam_01" targetRef="deaction_02">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_01_deaction_01" sourceRef="rawsfcode_01" targetRef="deaction_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-deaction_01" name="Gateway" gatewayDirection="Diverging" default="gateway-deaction_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="deaction_01_gateway-deaction_01_gatewayline" sourceRef="deaction_01" targetRef="gateway-deaction_01"></sequenceFlow>
                            <sequenceFlow id="gateway-deaction_01_end_line" sourceRef="gateway-deaction_01" targetRef="gateway-deaction_01_end"/>
                            <endEvent id="gateway-deaction_01_end" name="end"/>
        </process>
    </definitions>