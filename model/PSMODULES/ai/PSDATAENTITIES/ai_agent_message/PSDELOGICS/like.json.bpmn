<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.ai.service.logic.ai_agent_messagelike" isClosed="false" isExecutable="true" name="ai_ai_agent_message_like_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.ai.service.logic.ai_agent_messagelike">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_agent_messagelikedefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_agent_feedback()" name="ai_agent_messagelikeai_agent_feedback" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.ai.domain.ai_agent_message()" name="ai_agent_messagelikemessage" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_agent_feedbackService))" name="ai_agent_feedbackservice" type="service"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_agent_messageService))" name="ai_agent_messageservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.ai.service.Iai_agent_messageService))" name="iBzSysAi_agent_messageDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_agent_messagelikedefault" type="cn.ibizlab.plm.core.ai.domain.ai_agent_message" />
                            <tns:global identifier="ai_agent_messagelikeai_agent_feedback" type="cn.ibizlab.plm.core.ai.domain.ai_agent_feedback" />
                            <tns:global identifier="ai_agent_messagelikemessage" type="cn.ibizlab.plm.core.ai.domain.ai_agent_message" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messagelikeprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="准备点赞参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messagelikedeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="生成点赞记录"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messagelikeprepareparam_02" id="prepareparam_02" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messagelikedelogic_01" id="delogic_01" implementation="http://www.jboss.org/drools/rule" name="取消点赞或点踩"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messagelikeend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messagelikedeaction_02" id="deaction_02" implementation="http://www.jboss.org/drools/rule" name="获取消息信息"/>
                        <endEvent id="deaction_02_end" name="end"/>
                        <sequenceFlow id="deaction_02_end_line" sourceRef="deaction_02" targetRef="deaction_02_end"/>
                    <sequenceFlow id="begin_prepareparam_02" sourceRef="begin" targetRef="prepareparam_02">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_deaction_01" sourceRef="prepareparam_01" targetRef="deaction_01">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_01_end_01" sourceRef="deaction_01" targetRef="end_01">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_02_delogic_01" sourceRef="prepareparam_02" targetRef="delogic_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-delogic_01_prepareparam_01" sourceRef="gateway-delogic_01" targetRef="prepareparam_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_messagelikedefault:ai_agent_message();
                                            $ai_agent_messagelikeai_agent_feedback:ai_agent_feedback();
                                            $ai_agent_messagelikemessage:ai_agent_message();
                                    eval($ai_agent_messagelikedefault==ai_agent_messagelikedefault && $ai_agent_messagelikeai_agent_feedback==ai_agent_messagelikeai_agent_feedback && $ai_agent_messagelikemessage==ai_agent_messagelikemessage);
                                eval((RuleUtils.test($ai_agent_messagelikemessage.get("isLike"),"NOTEQ","1")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-delogic_01_end_01" sourceRef="gateway-delogic_01" targetRef="end_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_messagelikedefault:ai_agent_message();
                                            $ai_agent_messagelikeai_agent_feedback:ai_agent_feedback();
                                            $ai_agent_messagelikemessage:ai_agent_message();
                                    eval($ai_agent_messagelikedefault==ai_agent_messagelikedefault && $ai_agent_messagelikeai_agent_feedback==ai_agent_messagelikeai_agent_feedback && $ai_agent_messagelikemessage==ai_agent_messagelikemessage);
                                eval((RuleUtils.test($ai_agent_messagelikemessage.get("isLike"),"EQ","1")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-delogic_01" name="Gateway" gatewayDirection="Diverging" default="gateway-delogic_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="delogic_01_gateway-delogic_01_gatewayline" sourceRef="delogic_01" targetRef="gateway-delogic_01"></sequenceFlow>
                            <sequenceFlow id="gateway-delogic_01_end_line" sourceRef="gateway-delogic_01" targetRef="gateway-delogic_01_end"/>
                            <endEvent id="gateway-delogic_01_end" name="end"/>
        </process>
    </definitions>