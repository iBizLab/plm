<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.base.service.logic.categorysort" isClosed="false" isExecutable="true" name="base_category_sort_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.base.service.logic.categorysort">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="categorysortdefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.base.domain.category()" name="categorysortfilter" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.base.domain.category()" name="categorysortpage" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.base.service.IcategoryService))" name="categoryservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.base.service.IcategoryService))" name="iBzSysCategoryDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="categorysortdefault" type="cn.ibizlab.plm.core.base.domain.category" />
                            <tns:global identifier="categorysortfilter" type="cn.ibizlab.plm.core.base.domain.category" />
                            <tns:global identifier="categorysortpage" type="cn.ibizlab.plm.core.base.domain.category" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="categorysortprepareparam1" id="prepareparam1" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="categorysortdedataset1" id="dedataset1" implementation="http://www.jboss.org/drools/rule" name="实体数据集"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="categorysortdebugparam_01" id="debugparam_01" implementation="http://www.jboss.org/drools/rule" name="调试逻辑参数page########"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="categorysortrawsfcode1" id="rawsfcode1" implementation="http://www.jboss.org/drools/rule" name="执行脚本代码"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="categorysortend1" id="end1" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end1_end" name="end"/>
                        <sequenceFlow id="end1_end_line" sourceRef="end1" targetRef="end1_end"/>
                    <sequenceFlow id="begin_prepareparam1" sourceRef="begin" targetRef="prepareparam1">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam1_dedataset1" sourceRef="prepareparam1" targetRef="dedataset1">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-dedataset1_debugparam_01" sourceRef="gateway-dedataset1" targetRef="debugparam_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $categorysortdefault:category();
                                            $categorysortfilter:category();
                                            $categorysortpage:category();
                                    eval($categorysortdefault==categorysortdefault && $categorysortfilter==categorysortfilter && $categorysortpage==categorysortpage);
                                eval((RuleUtils.test($categorysortpage.get("size"),"GT","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="debugparam_01_rawsfcode1" sourceRef="debugparam_01" targetRef="rawsfcode1">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode1_end1" sourceRef="rawsfcode1" targetRef="end1">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-dedataset1" name="Gateway" gatewayDirection="Diverging" default="gateway-dedataset1_end_line"></exclusiveGateway>
                            <sequenceFlow id="dedataset1_gateway-dedataset1_gatewayline" sourceRef="dedataset1" targetRef="gateway-dedataset1"></sequenceFlow>
                            <sequenceFlow id="gateway-dedataset1_end_line" sourceRef="gateway-dedataset1" targetRef="gateway-dedataset1_end"/>
                            <endEvent id="gateway-dedataset1_end" name="end"/>
        </process>
    </definitions>