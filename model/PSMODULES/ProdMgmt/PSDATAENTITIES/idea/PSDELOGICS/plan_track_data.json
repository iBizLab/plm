    "code" : "def page_ideas = logic.param('page_ideas').getReal()\r\ndef relation_idea = logic.param('re_page_idea').getReal()\r\ndef relation_work_item = logic.param('re_page_item').getReal()\r\ndef relation_ticket = logic.param('re_page_ticket').getReal()\r\ndef relation_test_case = logic.param('re_page_case').getReal()\r\ndef result = logic.param('result').getReal()\r\n\r\n// 构建需求映射表（principal_id -> 需求列表）\r\nMap<String, List<Object>> ideaMap = [:]\r\nrelation_idea.each { item ->\r\n    String principalId = item.get(\"principal_id\")\r\n    if (!ideaMap.containsKey(principalId)) {\r\n        ideaMap[principalId] = []\r\n    }\r\n    ideaMap[principalId] << item\r\n}\r\n\r\n// 构建工作项映射表（requirement_id -> 工作项列表）\r\nMap<String, List<Object>> workItemMap = [:]\r\nrelation_work_item.each { item ->\r\n    String reqId = item.get(\"requirement_id\")\r\n    if (!workItemMap.containsKey(reqId)) {\r\n        workItemMap[reqId] = []\r\n    }\r\n    workItemMap[reqId] << item\r\n}\r\n\r\n// 构建工单映射表（requirement_id -> 工单列表）\r\nMap<String, List<Object>> ticketMap = [:]\r\nrelation_ticket.each { item ->\r\n    String reqId = item.get(\"requirement_id\")\r\n    if (!ticketMap.containsKey(reqId)) {\r\n        ticketMap[reqId] = []\r\n    }\r\n    ticketMap[reqId] << item\r\n}\r\n\r\n// 构建测试用例映射表（requirement_id -> 测试用例列表）\r\nMap<String, List<Object>> testCaseMap = [:]\r\nrelation_test_case.each { item ->\r\n    String reqId = item.get(\"requirement_id\")\r\n    if (!testCaseMap.containsKey(reqId)) {\r\n        testCaseMap[reqId] = []\r\n    }\r\n    testCaseMap[reqId] << item\r\n}\r\n\r\n// 3. 主循环处理\r\npage_ideas.each { idea ->\r\n    String id = idea.get(\"id\")\r\n\r\n    // a. 获取关联需求（principal_id匹配）\r\n    List<Object> relatedIdeas = ideaMap.getOrDefault(id, [])\r\n\r\n    // b. 获取关联工作项\r\n    List<Object> relatedWorkItems = workItemMap.getOrDefault(id, [])\r\n\r\n    // c. 获取关联工单\r\n    List<Object> relatedTickets = ticketMap.getOrDefault(id, [])\r\n\r\n    // d. 获取关联测试用例\r\n    List<Object> relatedTestCases = testCaseMap.getOrDefault(id, [])\r\n\r\n    // 5. 组装数据\r\n    idea.set(\"re_idea\", relatedIdeas)\r\n    idea.set(\"re_item\", relatedWorkItems)\r\n    idea.set(\"re_ticket\", relatedTickets)\r\n    idea.set(\"re_case\", relatedTestCases)\r\n    idea.set(\"idea_sum\", relatedIdeas.size())\r\n    idea.set(\"ticket_sum\", relatedTickets.size())\r\n    idea.set(\"work_item_sum\", relatedWorkItems.size())\r\n    idea.set(\"test_case_sum\", relatedTestCases.size())\r\n\r\n    // 6. 添加到结果集\r\n    result << idea\r\n}",
