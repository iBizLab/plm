                                <tns:metaData express="new cn.ibizlab.plm.core.projmgmt.domain.project_member()" name="work_itemworkload_work_itemmembers" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.projmgmt.domain.work_item()" name="work_itemworkload_work_itemwork_item_filter" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.projmgmt.service.Iproject_memberService))" name="project_memberservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.projmgmt.service.Iwork_itemService))" name="iBzSysWork_itemDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="work_itemworkload_work_itemdefault" type="cn.ibizlab.plm.core.projmgmt.domain.work_item" />
                            <tns:global identifier="work_itemworkload_work_itemfilter" type="cn.ibizlab.plm.core.projmgmt.domain.project_member" />
                            <tns:global identifier="work_itemworkload_work_itemmembers" type="cn.ibizlab.plm.core.projmgmt.domain.project_member" />
                            <tns:global identifier="work_itemworkload_work_itemwork_item_filter" type="cn.ibizlab.plm.core.projmgmt.domain.work_item" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemdebugparam1" id="debugparam1" implementation="http://www.jboss.org/drools/rule" name="调试逻辑参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemend2" id="end2" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end2_end" name="end"/>
                        <sequenceFlow id="end2_end_line" sourceRef="end2" targetRef="end2_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemprepareparam2" id="prepareparam2" implementation="http://www.jboss.org/drools/rule" name="获取产品ID并设置过滤参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemprepareparam3" id="prepareparam3" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemrawsfcode3" id="rawsfcode3" implementation="http://www.jboss.org/drools/rule" name="判断系统管理员身份"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemdedataset3" id="dedataset3" implementation="http://www.jboss.org/drools/rule" name="查询当前用户是否为项目成员"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemprepareparam5" id="prepareparam5" implementation="http://www.jboss.org/drools/rule" name="绑定用户数据到for_obj"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemrawsfcode1" id="rawsfcode1" implementation="http://www.jboss.org/drools/rule" name="只读权限"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemrawsfcode2" id="rawsfcode2" implementation="http://www.jboss.org/drools/rule" name="非只读权限"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_itemworkload_work_itemend6" id="end6" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end6_end" name="end"/>
                        <sequenceFlow id="end6_end_line" sourceRef="end6" targetRef="end6_end"/>
                    <sequenceFlow id="begin_debugparam1" sourceRef="begin" targetRef="debugparam1">
                    </sequenceFlow>
                    <sequenceFlow id="debugparam1_prepareparam3" sourceRef="debugparam1" targetRef="prepareparam3">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam2_dedataset3" sourceRef="prepareparam2" targetRef="dedataset3">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam3_rawsfcode3" sourceRef="prepareparam3" targetRef="rawsfcode3">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-rawsfcode3_prepareparam2" sourceRef="gateway-rawsfcode3" targetRef="prepareparam2">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $work_itemworkload_work_itemdefault:work_item();
                                            $work_itemworkload_work_itemfilter:project_member();
                                            $work_itemworkload_work_itemfor_obj:Map();
                                            $work_itemworkload_work_itemmembers:project_member();
                                            $work_itemworkload_work_itemwork_item_filter:work_item();
                                    eval($work_itemworkload_work_itemdefault==work_itemworkload_work_itemdefault && $work_itemworkload_work_itemfilter==work_itemworkload_work_itemfilter && $work_itemworkload_work_itemmembers==work_itemworkload_work_itemmembers && $work_itemworkload_work_itemwork_item_filter==work_itemworkload_work_itemwork_item_filter);
                                eval((RuleUtils.test($work_itemworkload_work_itemdefault.get("srfreadonly"),"ISNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-rawsfcode3_end2" sourceRef="gateway-rawsfcode3" targetRef="end2">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $work_itemworkload_work_itemdefault:work_item();
                                            $work_itemworkload_work_itemfilter:project_member();
                                            $work_itemworkload_work_itemfor_obj:Map();
                                            $work_itemworkload_work_itemmembers:project_member();
                                            $work_itemworkload_work_itemwork_item_filter:work_item();
                                    eval($work_itemworkload_work_itemdefault==work_itemworkload_work_itemdefault && $work_itemworkload_work_itemfilter==work_itemworkload_work_itemfilter && $work_itemworkload_work_itemmembers==work_itemworkload_work_itemmembers && $work_itemworkload_work_itemwork_item_filter==work_itemworkload_work_itemwork_item_filter);
                                eval((RuleUtils.test($work_itemworkload_work_itemdefault.get("srfreadonly"),"EQ","false")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-dedataset3_rawsfcode1" sourceRef="gateway-dedataset3" targetRef="rawsfcode1">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $work_itemworkload_work_itemdefault:work_item();
                                            $work_itemworkload_work_itemfilter:project_member();
                                            $work_itemworkload_work_itemfor_obj:Map();
                                            $work_itemworkload_work_itemmembers:project_member();
                                            $work_itemworkload_work_itemwork_item_filter:work_item();
                                    eval($work_itemworkload_work_itemdefault==work_itemworkload_work_itemdefault && $work_itemworkload_work_itemfilter==work_itemworkload_work_itemfilter && $work_itemworkload_work_itemmembers==work_itemworkload_work_itemmembers && $work_itemworkload_work_itemwork_item_filter==work_itemworkload_work_itemwork_item_filter);
                                eval((RuleUtils.test($work_itemworkload_work_itemmembers.get("size"),"EQ","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-dedataset3_prepareparam5" sourceRef="gateway-dedataset3" targetRef="prepareparam5">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $work_itemworkload_work_itemdefault:work_item();
                                            $work_itemworkload_work_itemfilter:project_member();
                                            $work_itemworkload_work_itemfor_obj:Map();
                                            $work_itemworkload_work_itemmembers:project_member();
                                            $work_itemworkload_work_itemwork_item_filter:work_item();
                                    eval($work_itemworkload_work_itemdefault==work_itemworkload_work_itemdefault && $work_itemworkload_work_itemfilter==work_itemworkload_work_itemfilter && $work_itemworkload_work_itemmembers==work_itemworkload_work_itemmembers && $work_itemworkload_work_itemwork_item_filter==work_itemworkload_work_itemwork_item_filter);
                                eval((RuleUtils.test($work_itemworkload_work_itemmembers.get("size"),"EQ","1")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-prepareparam5_rawsfcode2" sourceRef="gateway-prepareparam5" targetRef="rawsfcode2">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $work_itemworkload_work_itemdefault:work_item();
                                            $work_itemworkload_work_itemfilter:project_member();
                                            $work_itemworkload_work_itemfor_obj:Map();
                                            $work_itemworkload_work_itemmembers:project_member();
                                            $work_itemworkload_work_itemwork_item_filter:work_item();
                                    eval($work_itemworkload_work_itemdefault==work_itemworkload_work_itemdefault && $work_itemworkload_work_itemfilter==work_itemworkload_work_itemfilter && $work_itemworkload_work_itemmembers==work_itemworkload_work_itemmembers && $work_itemworkload_work_itemwork_item_filter==work_itemworkload_work_itemwork_item_filter);
                                eval((RuleUtils.test($work_itemworkload_work_itemfor_obj.get("role_id"),"NOTEQ","reader")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-prepareparam5_rawsfcode1" sourceRef="gateway-prepareparam5" targetRef="rawsfcode1">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $work_itemworkload_work_itemdefault:work_item();
                                            $work_itemworkload_work_itemfilter:project_member();
                                            $work_itemworkload_work_itemfor_obj:Map();
                                            $work_itemworkload_work_itemmembers:project_member();
                                            $work_itemworkload_work_itemwork_item_filter:work_item();
                                    eval($work_itemworkload_work_itemdefault==work_itemworkload_work_itemdefault && $work_itemworkload_work_itemfilter==work_itemworkload_work_itemfilter && $work_itemworkload_work_itemmembers==work_itemworkload_work_itemmembers && $work_itemworkload_work_itemwork_item_filter==work_itemworkload_work_itemwork_item_filter);
                                eval((RuleUtils.test($work_itemworkload_work_itemfor_obj.get("role_id"),"EQ","reader")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode1_end6" sourceRef="rawsfcode1" targetRef="end6">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode2_end6" sourceRef="rawsfcode2" targetRef="end6">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-rawsfcode3" name="Gateway" gatewayDirection="Diverging" default="gateway-rawsfcode3_end_line"></exclusiveGateway>
                            <sequenceFlow id="rawsfcode3_gateway-rawsfcode3_gatewayline" sourceRef="rawsfcode3" targetRef="gateway-rawsfcode3"></sequenceFlow>
                            <sequenceFlow id="gateway-rawsfcode3_end_line" sourceRef="gateway-rawsfcode3" targetRef="gateway-rawsfcode3_end"/>
                            <endEvent id="gateway-rawsfcode3_end" name="end"/>
                            <exclusiveGateway id="gateway-dedataset3" name="Gateway" gatewayDirection="Diverging" default="gateway-dedataset3_end_line"></exclusiveGateway>
                            <sequenceFlow id="dedataset3_gateway-dedataset3_gatewayline" sourceRef="dedataset3" targetRef="gateway-dedataset3"></sequenceFlow>
                            <sequenceFlow id="gateway-dedataset3_end_line" sourceRef="gateway-dedataset3" targetRef="gateway-dedataset3_end"/>
                            <endEvent id="gateway-dedataset3_end" name="end"/>
                            <exclusiveGateway id="gateway-prepareparam5" name="Gateway" gatewayDirection="Diverging" default="gateway-prepareparam5_end_line"></exclusiveGateway>
                            <sequenceFlow id="prepareparam5_gateway-prepareparam5_gatewayline" sourceRef="prepareparam5" targetRef="gateway-prepareparam5"></sequenceFlow>
                            <sequenceFlow id="gateway-prepareparam5_end_line" sourceRef="gateway-prepareparam5" targetRef="gateway-prepareparam5_end"/>
                            <endEvent id="gateway-prepareparam5_end" name="end"/>
        </process>
    </definitions>