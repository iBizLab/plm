<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.projmgmt.service.logic.projectcreate_from_template" isClosed="false" isExecutable="true" name="projmgmt_project_create_from_template_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.projmgmt.service.logic.projectcreate_from_template">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="projectcreate_from_templatedefault" type="entity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.projmgmt.service.IprojectService))" name="projectservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.projmgmt.service.IprojectService))" name="iBzSysProjectDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="projectcreate_from_templatedefault" type="cn.ibizlab.plm.core.projmgmt.domain.project" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="projectcreate_from_templatedeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="新建"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="projectcreate_from_templatedeaction_02" id="deaction_02" implementation="http://www.jboss.org/drools/rule" name="复制"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="projectcreate_from_templatedebugparam_01" id="debugparam_01" implementation="http://www.jboss.org/drools/rule" name="调试逻辑参数##"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="projectcreate_from_templateend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="projectcreate_from_templateprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                    <sequenceFlow id="gateway-begin_deaction_01" sourceRef="gateway-begin" targetRef="deaction_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $projectcreate_from_templatedefault:project();
                                    eval($projectcreate_from_templatedefault==projectcreate_from_templatedefault);
                                eval((RuleUtils.test($projectcreate_from_templatedefault.get("projectTemplateId"),"ISNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-begin_prepareparam_01" sourceRef="gateway-begin" targetRef="prepareparam_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $projectcreate_from_templatedefault:project();
                                    eval($projectcreate_from_templatedefault==projectcreate_from_templatedefault);
                                eval((RuleUtils.test($projectcreate_from_templatedefault.get("projectTemplateId"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="deaction_01_end_01" sourceRef="deaction_01" targetRef="end_01">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_02_debugparam_01" sourceRef="deaction_02" targetRef="debugparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="debugparam_01_end_01" sourceRef="debugparam_01" targetRef="end_01">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_deaction_02" sourceRef="prepareparam_01" targetRef="deaction_02">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-begin" name="Gateway" gatewayDirection="Diverging" default="gateway-begin_end_line"></exclusiveGateway>
                            <sequenceFlow id="begin_gateway-begin_gatewayline" sourceRef="begin" targetRef="gateway-begin"></sequenceFlow>
                            <sequenceFlow id="gateway-begin_end_line" sourceRef="gateway-begin" targetRef="gateway-begin_end"/>
                            <endEvent id="gateway-begin_end" name="end"/>
        </process>
    </definitions>