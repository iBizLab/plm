        <process id="cn.ibizlab.plm.core.projmgmt.service.logic.work_item_typedelete_custom_model" isClosed="false" isExecutable="true" name="projmgmt_work_item_type_delete_custom_model_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.projmgmt.service.logic.work_item_typedelete_custom_model">
