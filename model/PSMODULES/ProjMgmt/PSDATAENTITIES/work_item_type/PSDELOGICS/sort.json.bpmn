<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.projmgmt.service.logic.work_item_typesort" isClosed="false" isExecutable="true" name="projmgmt_work_item_type_sort_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.projmgmt.service.logic.work_item_typesort">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="work_item_typesortdefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.projmgmt.domain.work_item_type()" name="work_item_typesortfilter" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.projmgmt.domain.work_item_type()" name="work_item_typesortpage" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.projmgmt.service.Iwork_item_typeService))" name="work_item_typeservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.projmgmt.service.Iwork_item_typeService))" name="iBzSysWork_item_typeDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="work_item_typesortdefault" type="cn.ibizlab.plm.core.projmgmt.domain.work_item_type" />
                            <tns:global identifier="work_item_typesortfilter" type="cn.ibizlab.plm.core.projmgmt.domain.work_item_type" />
                            <tns:global identifier="work_item_typesortpage" type="cn.ibizlab.plm.core.projmgmt.domain.work_item_type" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typesortprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="填充默认编码值"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typesortprepareparam1" id="prepareparam1" implementation="http://www.jboss.org/drools/rule" name="准备查询参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typesortdedataset1" id="dedataset1" implementation="http://www.jboss.org/drools/rule" name="实体数据集"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typesortrawsfcode1" id="rawsfcode1" implementation="http://www.jboss.org/drools/rule" name="设置最大排序值"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typesortend1" id="end1" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end1_end" name="end"/>
                        <sequenceFlow id="end1_end_line" sourceRef="end1" targetRef="end1_end"/>
                    <sequenceFlow id="begin_prepareparam_01" sourceRef="begin" targetRef="prepareparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_prepareparam1" sourceRef="prepareparam_01" targetRef="prepareparam1">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam1_dedataset1" sourceRef="prepareparam1" targetRef="dedataset1">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-dedataset1_rawsfcode1" sourceRef="gateway-dedataset1" targetRef="rawsfcode1">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $work_item_typesortdefault:work_item_type();
                                            $work_item_typesortfilter:work_item_type();
                                            $work_item_typesortpage:work_item_type();
                                    eval($work_item_typesortdefault==work_item_typesortdefault && $work_item_typesortfilter==work_item_typesortfilter && $work_item_typesortpage==work_item_typesortpage);
                                eval((RuleUtils.test($work_item_typesortpage.get("size"),"GT","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="dedataset1_end1" sourceRef="dedataset1" targetRef="end1">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode1_end1" sourceRef="rawsfcode1" targetRef="end1">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-dedataset1" name="Gateway" gatewayDirection="Diverging" default="gateway-dedataset1_end_line"></exclusiveGateway>
                            <sequenceFlow id="dedataset1_gateway-dedataset1_gatewayline" sourceRef="dedataset1" targetRef="gateway-dedataset1"></sequenceFlow>
                            <sequenceFlow id="gateway-dedataset1_end_line" sourceRef="gateway-dedataset1" targetRef="gateway-dedataset1_end"/>
                            <endEvent id="gateway-dedataset1_end" name="end"/>
        </process>
    </definitions>