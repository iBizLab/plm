<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.plm.core.projmgmt.service.logic.work_item_typedelete_custom_form" isClosed="false" isExecutable="true" name="projmgmt_work_item_type_delete_custom_form_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.plm.core.projmgmt.service.logic.work_item_typedelete_custom_form">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.plm.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="work_item_typedelete_custom_formdefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.extension.domain.PSDEForm()" name="work_item_typedelete_custom_formmain_deform" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.plm.core.extension.domain.PSDEForm()" name="work_item_typedelete_custom_formnew_deform" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.extension.service.IPSDEFormService))" name="psdeformservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.SpringContextHolder).getBean(T(cn.ibizlab.plm.core.projmgmt.service.Iwork_item_typeService))" name="iBzSysWork_item_typeDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.plm.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="work_item_typedelete_custom_formdefault" type="cn.ibizlab.plm.core.projmgmt.domain.work_item_type" />
                            <tns:global identifier="work_item_typedelete_custom_formmain_deform" type="cn.ibizlab.plm.core.extension.domain.PSDEForm" />
                            <tns:global identifier="work_item_typedelete_custom_formnew_deform" type="cn.ibizlab.plm.core.extension.domain.PSDEForm" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typedelete_custom_formrawsfcode_01" id="rawsfcode_01" implementation="http://www.jboss.org/drools/rule" name="拼接form标识"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typedelete_custom_formdeaction_03" id="deaction_03" implementation="http://www.jboss.org/drools/rule" name="获取主视图表单"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typedelete_custom_formdeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="获取新建表单"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typedelete_custom_formdeaction_02" id="deaction_02" implementation="http://www.jboss.org/drools/rule" name="删除新建表单"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typedelete_custom_formdeaction_04" id="deaction_04" implementation="http://www.jboss.org/drools/rule" name="删除主视图表单"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="work_item_typedelete_custom_formend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_rawsfcode_01" sourceRef="begin" targetRef="rawsfcode_01">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_01_deaction_01" sourceRef="rawsfcode_01" targetRef="deaction_01">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_01_deaction_03" sourceRef="rawsfcode_01" targetRef="deaction_03">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_03_deaction_04" sourceRef="gateway-deaction_03" targetRef="deaction_04">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $work_item_typedelete_custom_formdefault:work_item_type();
                                            $work_item_typedelete_custom_formmain_deform:PSDEForm();
                                            $work_item_typedelete_custom_formnew_deform:PSDEForm();
                                    eval($work_item_typedelete_custom_formdefault==work_item_typedelete_custom_formdefault && $work_item_typedelete_custom_formmain_deform==work_item_typedelete_custom_formmain_deform && $work_item_typedelete_custom_formnew_deform==work_item_typedelete_custom_formnew_deform);
                                eval((RuleUtils.test($work_item_typedelete_custom_formmain_deform.get("psdeformid"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_01_deaction_02" sourceRef="gateway-deaction_01" targetRef="deaction_02">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $work_item_typedelete_custom_formdefault:work_item_type();
                                            $work_item_typedelete_custom_formmain_deform:PSDEForm();
                                            $work_item_typedelete_custom_formnew_deform:PSDEForm();
                                    eval($work_item_typedelete_custom_formdefault==work_item_typedelete_custom_formdefault && $work_item_typedelete_custom_formmain_deform==work_item_typedelete_custom_formmain_deform && $work_item_typedelete_custom_formnew_deform==work_item_typedelete_custom_formnew_deform);
                                eval((RuleUtils.test($work_item_typedelete_custom_formnew_deform.get("psdeformid"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="deaction_02_end_01" sourceRef="deaction_02" targetRef="end_01">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_04_end_01" sourceRef="deaction_04" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-deaction_03" name="Gateway" gatewayDirection="Diverging" default="gateway-deaction_03_end_line"></exclusiveGateway>
                            <sequenceFlow id="deaction_03_gateway-deaction_03_gatewayline" sourceRef="deaction_03" targetRef="gateway-deaction_03"></sequenceFlow>
                            <sequenceFlow id="gateway-deaction_03_end_line" sourceRef="gateway-deaction_03" targetRef="gateway-deaction_03_end"/>
                            <endEvent id="gateway-deaction_03_end" name="end"/>
                            <exclusiveGateway id="gateway-deaction_01" name="Gateway" gatewayDirection="Diverging" default="gateway-deaction_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="deaction_01_gateway-deaction_01_gatewayline" sourceRef="deaction_01" targetRef="gateway-deaction_01"></sequenceFlow>
                            <sequenceFlow id="gateway-deaction_01_end_line" sourceRef="gateway-deaction_01" targetRef="gateway-deaction_01_end"/>
                            <endEvent id="gateway-deaction_01_end" name="end"/>
        </process>
    </definitions>