      "code" : "console.info(uiLogic.default);\nvar answer = null;\nvar formController = view.getController(\"form\");\nif(uiLogic.default.data && uiLogic.default.data.messages && uiLogic.default.data.messages.length>0) {\n    const lastAns = uiLogic.default.data.messages[uiLogic.default.data.messages.length-1];\n    answer = lastAns.realcontent;\n}\nelse if(uiLogic.default.msg) {\n    answer = uiLogic.default.msg.realcontent;\n}\n if(answer) {\n     if (answer && typeof answer == 'string') {\n        var ret ={\n                success: false,\n                data: null,\n                data_type: 'unknown',\n                raw_content: null,\n                message: '未找到有效的JSON或JSONArray内容'\n            };\n       // 定义匹配模式，按优先级排序\n        const patterns = [\n            {\n                pattern: /```json\\s*([\\s\\S]*?)\\s*```/,  // Markdown JSON代码块\n                cleanFn: (content) => content.replace(/```json|```/g, '').trim()\n            },\n            {\n                pattern: /```\\s*([\\s\\S]*?)\\s*```/,      // 普通代码块\n                cleanFn: (content) => content.replace(/```/g, '').trim()\n            },\n            {\n                pattern: /\\{[\\s\\S]*?\\}(?=\\s*[\\n\\r]|$)/, // 独立JSON对象\n                cleanFn: (content) => content.trim()\n            },\n            {\n                pattern: /\\[[\\s\\S]*?\\](?=\\s*[\\n\\r]|$)/,  // 独立JSON数组\n                cleanFn: (content) => content.trim()\n            }\n        ];\n\n        for (const { pattern, cleanFn } of patterns) {\n            const match = answer.match(pattern);\n            if (match) {\n                try {\n                    let content = match[0];\n                    content = cleanFn(content);\n                    \n                    // 解析JSON\n                    const parsed = JSON.parse(content);\n                    \n                    // 判断类型\n                    const jspn_type = Array.isArray(parsed) ? 'jsonarray' : 'jsonobject';\n                    ret = {\n                            success: true,\n                            data: parsed,\n                            data_type: jspn_type,\n                            raw_content: content,\n                            message: `成功提取${jspn_type === 'jsonarray' ? 'JSON数组' : 'JSON对象'}`\n                        };\n                    break;\n                } catch (error) {\n                    // 当前模式匹配但解析失败，继续尝试下一个模式\n                    continue;\n                }\n            }\n        }\n\n        if(ret.success && ret.data) {\n            if(ret.data_type == 'jsonobject' && formController) {\n                Object.entries(ret.data).forEach(([key, value]) => {\n                    // 调用表单控制器设置数据\n                    try {\n                        formController.setDataValue(key, value);\n                        console.log(`已设置表单字段: ${key} =`, value);\n                    } catch (error) {\n                    }\n                });\n            }\n\n            if(formController) {\n                try {\n                    formController.setDataValue(\"debug_callback_2\",ret.data);\n\n                } catch (error) {\n                }\n            }\n        }\n        else if(formController) {\n            try {\n                    formController.setDataValue(\"description\",answer);\n\n                } catch (error) {\n                }\n            try {\n                    formController.setDataValue(\"content\",answer);\n\n                } catch (error) {\n                }\n        }\n\n        \n    }\n\n    if(formController) {\n        try {\n            formController.setDataValue(\"debug_callback_1\",answer);\n        } catch (error) {\n        }\n    }\n}",
