      "getPSUIAction" : {
        "actionTarget" : "NONE",
        "caption" : "聚焦此实体",
        "codeName" : "focusEntity",
        "frontProcessType" : "OTHER",
        "fullCodeName" : "ai_kb_graph_entity_focusEntity",
        "name" : "聚焦此实体",
        "getPSAppDataEntity" : {
          "modelref" : true,
          "path" : "PSSYSAPPS/plmweb/PSAPPDATAENTITIES/ai_kb_graph_entity.json"
        },
        "scriptCode" : "console.log(\"聚焦此实体\");\r\nconst ai_kb_graph_entity = data[0].id;\r\nconst graph_tree = view.getCtrl(\"TREE\", \"treeexpbar2_tree\");\r\nconst graph = graph_tree.graph;\r\n\r\nfocusEntity(ai_kb_graph_entity);\r\nfunction focusEntity(entityId) {\r\n    // 1. 清除所有节点状态（包括高亮）\r\n    graph.setElementState(\r\n        graph.getNodeData().reduce((acc, node) => {\r\n            acc[node.id] = [];\r\n            return acc;\r\n        }, {})\r\n    );\r\n\r\n    // 2. 获取1～2跳邻居节点（去重）\r\n    const keepNodeIds = getNeighborNodes(entityId, 2);\r\n\r\n    // 3. 获取保留的边（仅保留子图内的边）\r\n    const keepEdgeIds = new Set();\r\n    graph.getEdges().forEach(edge => {\r\n        const sourceId = edge.getSource().id;\r\n        const targetId = edge.getTarget().id;\r\n        if (keepNodeIds.has(sourceId) && keepNodeIds.has(targetId)) {\r\n            keepEdgeIds.add(edge.id);\r\n        }\r\n    });\r\n\r\n    // 4. 隐藏非目标节点和边\r\n    graph.getNodes().forEach(node => {\r\n        if (!keepNodeIds.has(node.id)) node.hide();\r\n    });\r\n\r\n    graph.getEdges().forEach(edge => {\r\n        if (!keepEdgeIds.has(edge.id)) edge.hide();\r\n    });\r\n\r\n    // 5. 高亮中心节点（增强视觉焦点）\r\n    graph_tree.highlightElement(entityId, \"node\");\r\n    highlightCenterNode(entityId);\r\n}\r\n\r\n// 获取指定跳数的邻居节点（含中心节点）\r\nfunction getNeighborNodes(entityId, depth) {\r\n    const visited = new Set([entityId]);\r\n    const queue = [{ id: entityId, depth: 0 }];\r\n\r\n    while (queue.length) {\r\n        const { id, depth } = queue.shift();\r\n\r\n        // 跳数已达上限，停止扩展\r\n        if (depth >= depth) continue;\r\n\r\n        // 获取当前节点的所有边\r\n        const edges = graph.getEdgesByNode(graph.findById(id));\r\n\r\n        // 遍历所有相邻节点\r\n        edges.forEach(edge => {\r\n            const neighborId = edge.getSource().id === id\r\n                ? edge.getTarget().id\r\n                : edge.getSource().id;\r\n\r\n            if (!visited.has(neighborId)) {\r\n                visited.add(neighborId);\r\n                queue.push({ id: neighborId, depth: depth + 1 });\r\n            }\r\n        });\r\n    }\r\n\r\n    return visited;\r\n}\r\n\r\n// 优化中心节点视觉效果\r\nfunction highlightCenterNode(entityId) {\r\n    const node = graph.findById(entityId);\r\n    if (!node) return;\r\n\r\n    // 1. 调整中心节点大小（放大30%）\r\n    const size = node.getSize();\r\n    node.setSize(size.width * 1.3, size.height * 1.3);\r\n\r\n    // 2. 添加高亮状态（确保在隐藏操作后可见）\r\n    node.setState('highlight', true);\r\n\r\n    // 3. 确保中心节点在视图中心（G6 v3.0+）\r\n    graph.get('group').animate({\r\n        x: node.get('x'),\r\n        y: node.get('y')\r\n    }, 300, 'easeOutQuad');\r\n}",
