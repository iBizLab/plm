          "getPSControlRenders" : [ {
            "layoutPanelModel" : "console.log(\"绘制类型图标1\");\r\nvar type = data.type ? data.type : \"\";\r\nvar entityName = data.name ? data.name : \"\";\r\nvar codeValue = \"\";\r\nvar codeItem = \"\";\r\n\r\nif (type && type !== \"\") {\r\n    var codelisttag = \"ai__entity_types\";\r\n    const app = await ibiz.hub.getApp(context.srfappid);\r\n    const codelist = app.codeList;\r\n    codeItem = await codelist.getItem(codelisttag, type, context, \"\");\r\n    codeValue = codeItem.text;\r\n    if (codeItem.icon) {\r\n        // icon 是字符串，需要先解析为 JSON 对象\r\n        let iconArray;\r\n        try {\r\n            iconArray = JSON.parse(codeItem.icon);\r\n        } catch (e) {\r\n            console.error(\"解析 icon 字符串失败:\", e);\r\n            return codeValue; // 解析失败时回退到文本\r\n        }\r\n\r\n        if (Array.isArray(iconArray) && iconArray.length > 0) {\r\n            const icon = iconArray[0];\r\n            // 构建文件下载URL\r\n            const fileUrl = ibiz.util.file.calcFileUpDownUrl(\r\n                context,\r\n                {},\r\n                {},\r\n                { osscat: icon.folder }\r\n            );\r\n            // 替换文件ID\r\n            const downloadUrl = fileUrl.downloadUrl.replace(\"%fileId%\", icon.id);\r\n            if (icon.name && icon.name.split(\".\").pop() === \"svg\") {\r\n                try {\r\n                    const response = await fetch(downloadUrl);\r\n                    if (!response.ok) {\r\n                        return \"\";\r\n                    }\r\n                    const blob = await response.blob();\r\n\r\n                    // 6将SVG转换为base64\r\n                    const base64Data = await new Promise((resolve, reject) => {\r\n                        const reader = new FileReader();\r\n                        reader.onloadend = () => {\r\n                            let data = reader.result;\r\n                            if (data) {\r\n                                // 转换MIME类型\r\n                                data = data.replace(\"data:application/octet-stream;base64\", \"data:image/svg+xml;base64\");\r\n                            }\r\n                            resolve(data);\r\n                        };\r\n                        reader.onerror = reject;\r\n                        reader.readAsDataURL(blob);\r\n                    });\r\n                    const imgstr = `<img alt=\"${codeValue}\" src=\"${base64Data}\" style=\"width: 25px; height: 25px;\">`;\r\n                    return `<div class=\"ibiz-code-list__item\" style=\"height: 36px; line-height: 36px; display: flex; align-items: center;\">  $ {imgstr} $ {codeValue}</div>`;\r\n                } catch (error) {\r\n                    ibiz.log.error(error);\r\n                }\r\n            }else{\r\n                const imgstr = `<img alt=\"${codeValue}\" src=\"${downloadUrl}\" style=\"width: 25px; height: 25px;\">`;\r\n                return `<div class=\"ibiz-code-list__item\" style=\"height: 36px; line-height: 36px; display: flex; align-items: center;\">  $ {imgstr} $ {codeValue}</div>`;\r\n            }\r\n        }\r\n    }\r\n}\r\nreturn codeValue;",
            "name" : "type",
